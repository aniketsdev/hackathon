# Optional for advanced demo.
# Missing or rejected OpenAI keys show a non-blocking AI status; scanner findings still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub repository scan and webhook settings.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=demo-secret
GITHUB_POST_COMMENTS=false

# Optional allowlist. Leave empty to allow dynamically connected repositories.
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_API_BASE_URL=https://api.github.com

# GitHub OAuth login for private repository scans.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_SCOPE=read:user repo

# Use "postgres" for production persistence, "memory" for local tests, or "auto" to use
# Postgres when DATABASE_URL exists and memory otherwise.
GITHUB_OPERATION_STORE=auto
DATABASE_URL=
