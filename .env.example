# Optional AI summary provider
OPENAI_API_KEY=

# Required for live GitHub webhook verification
GITHUB_WEBHOOK_SECRET=replace-with-demo-secret

# Optional for live GitHub API calls and PR comments
GITHUB_TOKEN=
GITHUB_POST_COMMENTS=false

# Optional allowlist. Leave empty to allow dynamically connected repositories.
GITHUB_ALLOWED_REPOSITORIES=

# Optional GitHub Enterprise override
GITHUB_API_BASE_URL=https://api.github.com
